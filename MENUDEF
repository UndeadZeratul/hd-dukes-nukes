OptionMenu "DukesNukesMenu" {

	Title "$DUKESNUKES_MENU"

	Option "$MENU_WALLTRAPS", "uz_walltrap_spawners", "OnOff"
	StaticText ""
	StaticText ""

	StaticText "$MENU_MACHINEGUNS_TITLE", "Green"
	StaticText ""
	Submenu "$TAG_RIPPER", "ripperSpawning", 0, 1
	StaticText ""

	StaticText "$MENU_EXPLOSIVES_TITLE", "Brown"
	StaticText ""
	Submenu "$TAG_LASER_TRIPBOMB", "laserTripbombSpawning", 0, 1
	StaticText ""
	Submenu "$TAG_PIPEBOMB", "pipebombSpawning", 0, 1
	StaticText ""

	StaticText "$MENU_ITEMS_TITLE", "Red"
	StaticText ""
	Submenu "$TAG_HOLODUPE", "holoDupeSpawning", 0, 1
	StaticText ""

	StaticText "$MENU_RESETOPTIONS_TITLE", "Red"
	StaticText ""
	SafeCommand "$DUKESNUKES_RESETALLOPTIONS", "DukesNukes_Reset_Cvars"
}

AddOptionMenu "OptionsMenu" {
	Submenu "$DUKESNUKES_MENU", "DukesNukesMenu"
}

AddOptionMenu "HDAddonMenu" {
	Submenu "$DUKESNUKES_MENU", "DukesNukesMenu"
}


// Machine Guns

OptionMenu "ripperSpawning" {
	Title "$TAG_PIPEBOMB"

	StaticText "$MENU_NOTICE", "Green"
	StaticText "$MENU_SPAWNRATE_TEXT1", "White"
	StaticText "$MENU_SPAWNRATE_TEXT2", "White"
	StaticText ""

	StaticText "$MENU_SPAWNOPTIONS", "Green"
	StaticText "$MENU_PIPEBOMB_SPAWNTEXT", "White"
	Slider "$MENU_WEPSPAWNRATE", "pipebomb_spawn_bias", 0.0, 100, .01, 2
	SafeCommand "$MENU_RESETWEP", "resetcvar pipebomb_spawn_bias"
	StaticText ""

	StaticText "$MENU_PIPEBOMB_BACKPACKS", "White"
	Option "$MENU_BACKPACKSALLOWED", "pipebomb_allowBackpacks", "OnOff"
	StaticText ""

	StaticText "$MENU_PERSISTENCYOPTIONS", "Green"
	StaticText "$MENU_PERSISTENCY_TEXT", "White"
	Option "$MENU_PERSISTENCY", "pipebomb_persistent_spawning", "OnOff"
	SafeCommand "$MENU_RESETPERSISTENCY", "resetcvar pipebomb_persistent_spawning"
	StaticText ""
	StaticText ""

	StaticText "$MENU_RESETOPTIONS", "Green"
	SafeCommand "$MENU_RESETALLOPTIONS", "pipebomb_reset_cvars"
}


